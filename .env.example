# === AWS Bedrock ===
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2
# BEDROCK_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# === 서버 모드 ===
# USE_BEDROCK=true  # true면 Bedrock, 비워두면 fake mock

# === Open-Meteo (무키 — 별도 키 불필요) ===
# OPEN_METEO_BASE_URL=https://api.open-meteo.com

# === Aurora DB (이후 메모리 영속화 시 사용) ===
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# === OpenTelemetry 분산 트레이싱 ===
# OTEL_EXPORTER_OTLP_ENDPOINT가 설정된 경우에만 OTLP exporter가 활성화된다.
# 설정하지 않으면 (로컬 개발) tracing은 구성되지만 아무 곳으로도 전송되지 않는다.
# dev 값 예시:
# OTEL_SERVICE_NAME=backend-librarian
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_METRICS_EXPORTER=none   # 메트릭은 /actuator/prometheus 스크레이핑, 로그는 stdout 사용
# OTEL_LOGS_EXPORTER=none

# === Prometheus 메트릭 ===
# GET /actuator/prometheus 로 항상 노출됩니다 (별도 설정 불필요).
# application 라벨 값은 OTEL_SERVICE_NAME 을 따릅니다.

# === 구조화 로깅 ===
# LOG_LEVEL=INFO
